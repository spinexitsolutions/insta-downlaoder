# Copy these into your host's "Environment Variables" settings.
SITE_NAME=ReelSaver
SITE_URL=https://www.yourdomain.com
CONTACT_EMAIL=contact@yourdomain.com

# Google AdSense: publisher id from AdSense > Account > Account information.
ADSENSE_CLIENT=ca-pub-0000000000000000
# Optional: ad unit slot ids (AdSense > Ads > By ad unit). Leave empty to use Auto ads only.
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_RESULT=
ADSENSE_SLOT_BOTTOM=

# Optional: Google Analytics 4 measurement id
GA_MEASUREMENT_ID=

# Instagram login: a spare account with 2FA turned off. Required for stories.
# The site logs in by itself and renews the session automatically.
# Easiest: run `python login.py`, it fills these in.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# /api/info requests allowed per IP per minute
RATE_LIMIT_PER_MINUTE=15
